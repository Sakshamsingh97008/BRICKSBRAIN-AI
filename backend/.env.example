# ─────────────────────────────────────────────────────────────
# BRICKSBRAIN-AI Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bricksbrain
# MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bricksbrain?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Google APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Enable: Maps JS API, Places API, Distance Matrix API, Geocoding API, Directions API

# OpenWeather (for air quality & weather)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ML Service
ML_SERVICE_URL=http://localhost:8000

# AI Chat
OPENAI_API_KEY=your_openai_api_key_here
# OR Anthropic Claude:
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Payment (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# File uploads (Cloudinary or AWS S3)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────────────────────
# Frontend (React)
# ─────────────────────────────────────────────────────────────
# Create a separate .env file inside the /frontend folder:
# REACT_APP_API_URL=http://localhost:5000/api
# REACT_APP_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
